# Frontend Environment Variables

# API Configuration
# For local development: http://localhost:3000
# For production: Your Render backend URL
VITE_API_URL=http://localhost:3000

# Microsoft OAuth
VITE_MICROSOFT_CLIENT_ID=your-client-id
VITE_MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/callback
VITE_MICROSOFT_TENANT_ID=your-tenant-id

# Environment
VITE_NODE_ENV=development

# Super Admin Credentials (Development Only - Remove in Production)
VITE_SUPER_ADMIN_EMAIL=superadmin@admin.com
VITE_SUPER_ADMIN_PASSWORD=superadmin123

# ==========================================
# DEPLOYMENT INSTRUCTIONS
# ==========================================
# 
# FOR LOCAL DEVELOPMENT:
# - VITE_API_URL=http://localhost:3000
# - VITE_MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/callback
# 
# FOR VERCEL DEPLOYMENT:
# - VITE_API_URL=https://your-render-backend.onrender.com
# - VITE_MICROSOFT_REDIRECT_URI=https://your-render-backend.onrender.com/auth/callback
# - Set these in Vercel Dashboard > Settings > Environment Variables
# - Redeploy after changing environment variables
