# Backend Environment Variables
# Copy this file to .env and fill values. DO NOT commit your .env to git.

# Server Configuration
PORT=3000

# CORS - Multiple origins separated by comma
# For local: http://localhost:8080
# For production: Add your Vercel frontend URL
# Example: http://localhost:8080,https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:8080,https://next-v-ollama-project.vercel.app

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ollamaDB?retryWrites=true&w=majority

# Security
BCRYPT_ROUNDS=12
JWT_SECRET=super-long-random-secret-key-for-production-change-this-to-64-char-random-string
JWT_EXPIRES_IN=1h
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/callback

# Ollama Configuration
OLLAMA_IDLE_TIMEOUT_MS=300000
OLLAMA_TOTAL_TIMEOUT_MS=600000
OLLAMA_BASE_URL=http://localhost:11434

# Email Service (SendGrid)
SEND_GRID_API_KEY=your-sendgrid-api-key
SENDER_EMAIL=noreply@yourdomain.com

# OpenAI API (Optional)
OPENAI_API_KEY=your-openai-api-key

# ==========================================
# DEPLOYMENT INSTRUCTIONS
# ==========================================
# 
# FOR LOCAL DEVELOPMENT:
# - PORT=3000
# - FRONTEND_ORIGIN=http://localhost:8080
# - MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/callback
# 
# FOR RENDER DEPLOYMENT:
# - PORT will be set by Render automatically
# - FRONTEND_ORIGIN=https://your-vercel-app.vercel.app
# - MICROSOFT_REDIRECT_URI=https://your-render-backend.onrender.com/auth/callback
# - Set all these in Render Dashboard > Environment Variables
